# Base URL of the Vynix API. No trailing slash.
VYNIX_API_URL=https://vynix.in

# Authenticate either with a long-lived token...
VYNIX_API_TOKEN=

# ...or with account credentials (the server logs in and refreshes as needed).
VYNIX_API_EMAIL=
VYNIX_API_PASSWORD=

# Transport mode: stdio (default) or http (streamable HTTP for hosted/server use).
VYNIX_MCP_MODE=stdio

# HTTP mode settings (used when VYNIX_MCP_MODE=http).
VYNIX_MCP_HOST=127.0.0.1
VYNIX_MCP_PORT=8787
VYNIX_MCP_PATH=/mcp
