{
  "name": "@usevynix/mcp-server",
  "version": "0.1.4",
  "mcpName": "in.vynix/vynix-mcp",
  "license": "MIT",
  "type": "module",
  "description": "Model Context Protocol server that exposes Vynix annotations to AI coding agents.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vynix",
    "annotations",
    "feedback",
    "ai",
    "coding-agent",
    "cursor",
    "claude"
  ],
  "homepage": "https://www.vynix.in/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UseVynix/vynix-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/UseVynix/vynix-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "vynix-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "oauth:e2e": "node scripts/oauth-e2e.mjs",
    "test": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "eslint": "^10.8.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.1"
  }
}
